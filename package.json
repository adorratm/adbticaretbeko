{
  "name": "adb-ticaret",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "smoke:checkout": "powershell -NoProfile -File scripts/smoke-checkout.ps1",
    "sync:env": "powershell -NoProfile -File scripts/sync-env.ps1"
  },
  "devDependencies": {
    "turbo": "^2.11.6",
    "typescript": "^7.0.2"
  },
  "packageManager": "yarn@4.18.1",
  "volta": {
    "node": "26.10.0",
    "yarn": "4.18.1"
  },
  "engines": {
    "node": ">=26"
  }
}
