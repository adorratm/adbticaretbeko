APP_ENV=development

# PostgreSQL (single instance, per-service schemas)
POSTGRES_USER=adb
POSTGRES_PASSWORD=adb_dev_password
POSTGRES_DB=adb_ticaret
DATABASE_URL=postgres://adb:adb_dev_password@localhost:5433/adb_ticaret?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# NATS
NATS_URL=nats://localhost:4222

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=adb-products
S3_USE_SSL=false
S3_PUBLIC_URL=http://localhost:9000/adb-products

# Google OAuth (fill these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI_STOREFRONT=http://localhost:3000/auth/google/callback
GOOGLE_REDIRECT_URI_ADMIN=http://localhost:3001/auth/google/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Google Cloud Console → Authorized JavaScript origins:
#   http://localhost:3000  (storefront)
#   http://localhost:3001  (admin)
INITIAL_ALLOWED_ADMIN_EMAILS=

# Payment (Sprint B) — fill for real PSP later; mock works in development
PAYMENT_PROVIDER=mock
# PAYMENT_PROVIDER=iyzico | paytr | mock
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
PAYMENT_API_KEY=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYMENT_CALLBACK_URL=http://localhost:8080/api/v1/payments/webhook

# Shipping
SHIPPING_PROVIDER=mock

# Mail (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@adbticaret.local

# SMS (stub | netgsm) — anahtar yokken log stub
SMS_PROVIDER=stub
SMS_DEFAULT_TO=
NETGSM_USER=
NETGSM_PASS=
NETGSM_HEADER=ADBTICARET

# E-fatura stub (GİB canlı entegrasyon sonra)
EINVOICE_PROVIDER=stub
EINVOICE_TAX_RATE=20

# JWT (change in production)
JWT_SECRET=dev-jwt-access-secret-change-me
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Service URLs (local)
GATEWAY_ADDR=:8080
GATEWAY_PUBLIC_URL=http://localhost:8080
GATEWAY_RATE_LIMIT_RPS=40
GATEWAY_RATE_LIMIT_BURST=80
AUTH_URL=http://localhost:8081
CUSTOMER_URL=http://localhost:8082
CATALOG_URL=http://localhost:8083
INVENTORY_URL=http://localhost:8084
PRICING_URL=http://localhost:8085
PROMOTION_URL=http://localhost:8086
CART_URL=http://localhost:8087
CHECKOUT_URL=http://localhost:8088
ORDER_URL=http://localhost:8089
PAYMENT_URL=http://localhost:8090
SHIPMENT_URL=http://localhost:8091
NOTIFICATION_URL=http://localhost:8092
SEARCH_URL=http://localhost:8093
# Optional: docker compose --profile search up -d elasticsearch
ELASTICSEARCH_URL=
REVIEW_URL=http://localhost:8094
WISHLIST_URL=http://localhost:8095
MARKETPLACE_URL=http://localhost:8096
ACCOUNTING_URL=http://localhost:8097
REPORTING_URL=http://localhost:8098
WORKER_URL=http://localhost:8099
CMS_URL=http://localhost:8100
RETAIL_URL=http://localhost:8101

# Retail / Takas (Sprint C)
TRADE_IN_MAX_KURUS=1500000

# Beko ERP marketplace adapter (leave empty for stub)
BEKO_ERP_BASE_URL=https://erp.beko.example
BEKO_ERP_API_KEY=
BEKO_DEALER_CODE=BEKO-TR-340982
MARKETPLACE_DEFAULT_PROVIDER=beko-erp
TRENDYOL_SUPPLIER_ID=
TRENDYOL_API_KEY=
TRENDYOL_API_SECRET=
HB_MERCHANT_ID=
HB_API_KEY=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
STOREFRONT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Socket.io realtime (services/realtime)
NEXT_PUBLIC_REALTIME_URL=http://localhost:8102
REALTIME_URL=http://localhost:8102
REALTIME_INTERNAL_SECRET=adb-dev-realtime

